rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Checks if the authenticated user is the designated Master Admin
    function isMasterAdmin() {
      return isAuthenticated() && request.auth.token.email.lower() == 'silvadilan9@gmail.com';
    }

    // =========================================================================
    // 1. පින්කම් සටහන් (Merit Posts) සඳහා වන Production Security Rules
    // =========================================================================
    match /merit_posts/{postId} {
      // 1.1. පුණ්‍ය පවුරේ ඇති පින්කම් කියවීම (Read):
      // ප්‍රජා පින්කම් ජාලයේ පොදු සටහන් සියලු දෙනාට නැරඹිය හැක
      allow read: if true;
      
      // 1.2. සටහන් නිර්මාණය කිරීම (Create):
      // සටහනක් පළ කිරීමට අනිවාර්යයෙන්ම Log වී සිටිය යුතුය, තම UID එක පමණක් භාවිතා කළ යුතුය.
      // අනවසරයෙන් Admin බලතල, නිල සලකුණු (isOfficial), Pin කිරීම් තමන් විසින්ම ලබාගැනීම අවහිර කෙරේ.
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && (request.resource.data.type in ['repost', 'general', 'reel'] || (request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 150))
                    && (request.resource.data.type in ['repost', 'reel'] || (request.resource.data.description.size() >= 3 && request.resource.data.description.size() <= 3000))
                    && request.resource.data.category in ['දානමය', 'සීලමය', 'භාවනාමය', 'සමාජ සත්කාර', 'යළි බෙදාගැනීම්', 'සුබපැතුම්', 'සිතුවිලි', 'සාමාන්‍ය', 'ධර්ම දානමය']
                    && request.resource.data.type in ['merit', 'need', 'repost', 'general', 'reel']
                    // Admin-only fields cannot be self-granted by non-admin users
                    && (request.resource.data.isPinned != true || isMasterAdmin())
                    && (request.resource.data.isVerifiedNeed != true || isMasterAdmin())
                    && (request.resource.data.isOfficial != true || isMasterAdmin())
                    && (request.resource.data.authorRole != 'admin' && request.resource.data.authorRole != 'official' || isMasterAdmin());
      
      // 1.3. සටහන් යාවත්කාලීන කිරීම (Update):
      // සාදුකාර, ප්‍රතිචාර (comments), reposts සඳහා අනිවාර්යයෙන්ම Log වී සිටිය යුතුය.
      // අනවසර Bots / Crawlers මගින් comments හෝ sadhu count විකෘති කිරීම අවහිර කර ඇත.
      allow update: if (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sadhuCount', 'sadhuUsers']))
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sadhuCount']))
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sadhuUsers']))
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']))
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount'])
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostCount']))
                    // Soft-delete by author
                    || (isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedAt']))
                    // Full post edit by author (cannot change ownership or self-pin)
                    || (isAuthenticated() && resource.data.uid == request.auth.uid 
                        && request.resource.data.uid == resource.data.uid
                        && (request.resource.data.isPinned == resource.data.isPinned || isMasterAdmin())
                        && (request.resource.data.isVerifiedNeed == resource.data.isVerifiedNeed || isMasterAdmin()))
                    // Full update rights for Master Admin
                    || isMasterAdmin();

      // 1.4. සටහන Delete කිරීමේ දැඩි ආරක්ෂාව:
      // මැකිය හැක්කේ සටහන පළකළ සැබෑ හිමිකරුට (Author) හෝ Master Admin ට පමණි!
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isMasterAdmin());
    }
    
    // =========================================================================
    // 2. පරිශීලක පැතිකඩ (User Profiles)
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isMasterAdmin());
    }

    // =========================================================================
    // 3. දැනුම්දීම් (Notifications)
    // =========================================================================
    match /notifications/{notifId} {
      // පරිශීලකයාට අදාළ දැනුම්දීම් පමණක් කියවීමට අවසර දේ
      allow read: if isAuthenticated() && (resource.data.recipientUid == request.auth.uid || isMasterAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.recipientUid == request.auth.uid || isMasterAdmin());
    }

    // =========================================================================
    // 4. පද්ධති සැකසුම් (Admin Settings) - Master Admin ට පමණයි!
    // =========================================================================
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }
  }
}
