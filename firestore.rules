rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Checks if the authenticated user is the designated Master Admin
    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'silvadilan9@gmail.com' ||
        request.auth.token.email.lower() == 'creativeparadise25@gmail.com'
      );
    }

    // Helper: Checks if the authenticated user has Sub-Admin role in users collection
    function isSubAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Checks if user has admin privileges (Master or Sub-Admin)
    function isAdmin() {
      return isMasterAdmin() || isSubAdmin();
    }

    // Helper: Checks if user account has been banned
    function isBanned() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned == true;
    }

    // =========================================================================
    // 1. පින්කම් සටහන් (Merit Posts) සඳහා වන Production Security Rules
    // =========================================================================
    match /merit_posts/{postId} {
      // 1.1. පුණ්‍ය පවුරේ ඇති පින්කම් කියවීම (Read):
      allow read: if true;
      
      // 1.2. සටහන් නිර්මාණය කිරීම (Create):
      // Banned පරිශීලකයින්ට සටහන් දැමීම සම්පූර්ණයෙන්ම අවහිර කර ඇත.
      allow create: if isAuthenticated() && !isBanned()
                    && request.resource.data.uid == request.auth.uid
                    && (request.resource.data.type in ['repost', 'general', 'reel'] || (request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 150))
                    && (request.resource.data.type in ['repost', 'reel'] || (request.resource.data.description.size() >= 3 && request.resource.data.description.size() <= 3000))
                    && request.resource.data.category in ['දානමය', 'සීලමය', 'භාවනාමය', 'සමාජ සත්කාර', 'යළි බෙදාගැනීම්', 'සුබපැතුම්', 'සිතුවිලි', 'සාමාන්‍ය', 'ධර්ම දානමය']
                    && request.resource.data.type in ['merit', 'need', 'repost', 'general', 'reel']
                    // Admin-only fields cannot be self-granted by non-admin users
                    && (request.resource.data.isPinned != true || isAdmin())
                    && (request.resource.data.isVerifiedNeed != true || isAdmin())
                    && (request.resource.data.isOfficial != true || isMasterAdmin())
                    && (request.resource.data.authorRole != 'admin' && request.resource.data.authorRole != 'official' || isAdmin());
      
      // 1.3. සටහන් යාවත්කාලීන කිරීම (Update):
      allow update: if (isAuthenticated() && !isBanned() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sadhuCount', 'sadhuUsers']))
                    || (isAuthenticated() && !isBanned() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sadhuCount']))
                    || (isAuthenticated() && !isBanned() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sadhuUsers']))
                    || (isAuthenticated() && !isBanned() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']))
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount'])
                    || (isAuthenticated() && !isBanned() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostCount']))
                    // Soft-delete by author or Admin
                    || (isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedAt', 'deletedBy']))
                    // Full post edit by author (cannot change ownership or self-pin)
                    || (isAuthenticated() && !isBanned() && resource.data.uid == request.auth.uid 
                        && request.resource.data.uid == resource.data.uid
                        && (request.resource.data.isPinned == resource.data.isPinned || isAdmin())
                        && (request.resource.data.isVerifiedNeed == resource.data.isVerifiedNeed || isAdmin()))
                    // Full update rights for Master Admin or Sub-Admin
                    || isAdmin();

      // 1.4. සටහන Delete කිරීමේ ආරක්ෂාව:
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    
    // =========================================================================
    // 2. පරිශීලක පැතිකඩ (User Profiles & Role Management)
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && (request.resource.data.role != 'admin' && request.resource.data.role != 'master_admin' || isMasterAdmin())
                    && request.resource.data.isBanned != true;
      allow update: if isMasterAdmin()
                    || (isAdmin() && resource.data.role != 'master_admin' && resource.data.role != 'admin'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBanned', 'bannedAt', 'bannedReason', 'bannedBy']))
                    || (isAuthenticated() && request.auth.uid == userId && !isBanned()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned', 'bannedAt', 'bannedReason', 'bannedBy']));
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 3. දැනුම්දීම් (Notifications)
    // =========================================================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && !isBanned();
      allow update, delete: if isAuthenticated() && (resource.data.recipientUid == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 4. පද්ධති සැකසුම් (Admin Settings)
    // =========================================================================
    match /admin_settings/{settingId} {
      allow read: if true;
      allow update: if isAdmin();
      allow write: if isMasterAdmin();
    }

    // =========================================================================
    // 5. පරිපාලන ක්‍රියාකාරකම් සටහන් (Admin Audit Logs)
    // =========================================================================
    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if isMasterAdmin();
    }

    // =========================================================================
    // 6. ආරණ්‍ය සේනාසන නාමාවලිය (Aranya Senasana Directory)
    // =========================================================================
    match /aranya_senasana/{aranyaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /aranya_suggestions/{suggId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
